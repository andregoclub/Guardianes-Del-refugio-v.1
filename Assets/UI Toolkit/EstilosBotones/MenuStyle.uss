:root {
}

.header {
    align-self: center;
    font-size: 171px;
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Packages/com.unity.render-pipelines.core/Runtime/Debugging/Prefabs/Fonts/PerfectDOSVGA437.ttf?fileID=12800000&guid=74a5091d8707f334b9a5c31ef71a64ba&type=3#PerfectDOSVGA437");
    color: rgb(66, 215, 125);
    -unity-text-outline-width: 7px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-color: rgb(62, 62, 63);
    background-size: 110% 100%;
    border-left-width: 36px;
    border-top-left-radius: 66px;
    border-top-right-radius: 66px;
    border-bottom-right-radius: 66px;
    border-bottom-left-radius: 66px;
}
